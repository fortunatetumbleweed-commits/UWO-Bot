# Training data — sessions and labels can be large; not committed
data/sessions/
data/labels.jsonl

# Heading-CNN training pipeline — derived data, regenerable from
# data/sessions/ via tools/mine_heading_labels + extract_ship_sprites
# + sample_minimap_backgrounds.  Model weights at data/heading_cnn/
# ARE committed so production can load them.
data/heading_labels/
data/heading_sprites/
data/heading_backgrounds/
data/heading_samples_review/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# Third-party model weights — downloaded at runtime, not ours to commit
vision/models/

# Bot-generated knowledge base — runtime data; will commit once self-learning matures
# Hand-authored files (culture_rules.py, config/) are tracked separately below.
memory/knowledge/building_types/
memory/knowledge/buildings/
memory/knowledge/flows/
memory/knowledge/interactions/
memory/knowledge/markets/
memory/knowledge/ports/
memory/knowledge/scenes/
memory/knowledge/screens/
memory/knowledge/learned_fingerprints/
memory/knowledge/port_map_tap_offsets.json
memory/discoveries/screenshots/

# Debug / runtime artifacts
debug_capture.png
debug_*.png
*.png
!vision/assets/**/*.png
!data/reference/**/*.png
# Stage frames are REAL CAPTURES and stay OUT of the repo (user, 2026-08-31). They were
# tracked from 2026-08-26 so they would survive a prune of data/sessions/ ("kept and will not
# be affected or forgotten") — that concern still stands, and is met by keeping them in a
# durable folder outside the repo rather than by committing 34 MB of PNGs into history.
#
# Tests that use them skip when absent:
#     if not os.path.exists(STAGE): self.skipTest("stage frame not available")
# so a checkout without frames runs clean — but note the cost of that: the evidence goes
# missing QUIETLY. Pull the frames you need out of a recorded session under data/sessions/.
tests/stage_suite/frames/*.png
memory/logs/
memory/discoveries/*.json

# Keep directory structure
!memory/discoveries/.gitkeep
!vision/assets/screens/.gitkeep

# OS
.DS_Store

# IDE
.vscode/
.idea/
models/screen_classifier/
data/rl/
models/

# README / doc media (committed)
!docs/media/*.png
!docs/media/*.gif

# README is ignored by the user global gitignore; keep it for this repo
!README.md

# Reference frames for screen-identity tests are FIXTURES, not captures — a blanket *.png
# rule would drop them and the tests would break on a fresh checkout. Keep this set small:
# only frames that pin a behaviour worth regressing on.
!data/test_frames/
!data/test_frames/**

# Where the fleet was last seen — runtime state, written by the bot on every new settlement.
# Tracking it means a clone starts believing the fleet is wherever the last committer's run
# ended, and it was carrying a value written by the TEST SUITE (see
# tests/test_the_suite_does_not_move_the_fleet.py).
memory/knowledge/state/last_settlement.json
